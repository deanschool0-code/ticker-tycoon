# Ticker Tycoon API keys. All are optional and free; the game works without them.
# Copy this file to .env (run.sh does it for you), paste your keys, then restart: bash run.sh

# Finnhub: better company & crypto news, stock quote fallback, company logos
# Get it: https://finnhub.io/register  -> Dashboard -> API key
FINNHUB_KEY=

# YouTube Data API v3: the Learn tab finds, ranks and embeds videos automatically
# Get it: https://console.cloud.google.com -> new project -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# CoinGecko demo key: higher crypto rate limits (optional)
# Get it: https://www.coingecko.com/en/api/pricing -> "Demo" (free) plan
COINGECKO_KEY=

# Port (5555-5557 are used by Jarvis, Scholars and Matt)
PORT=5558
